/* pages/detail/detail.wxss */
.container {
  padding: 40rpx;
  text-align: center;
}

.loading {
  display: flex;
  justify-content: center;
  padding: 40rpx;
}

.sprite {
  width: 300rpx;
  height: 300rpx;
  margin: 0 auto;
}

.pokemon-name {
  font-size: 48rpx;
  font-weight: bold;
  display: block;
  margin: 20rpx 0;
}

.abilities {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20rpx;
  margin: 30rpx 0;
}

.ability {
  background-color: #f0f0f0;
  padding: 10rpx 30rpx;
  border-radius: 40rpx;
  font-size: 32rpx;
}

button {
  margin-top: 40rpx;
}