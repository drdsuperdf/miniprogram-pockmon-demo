/* pages/home/home.wxss */
.container {
  padding: 30rpx;
}

.header {
  margin-bottom: 40rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  display: block;
}

.total {
  font-size: 32rpx;
  color: #666;
  margin-top: 10rpx;
  display: block;
}

.type-section {
  margin-bottom: 40rpx;
}

.section-label {
  font-weight: bold;
  margin-bottom: 10rpx;
  display: block;
}

.type-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.type-btn {
  margin: 0;
  padding: 10rpx 20rpx;
  font-size: 28rpx;
  border: 1px solid #ccc;
  background-color: #fff;
  border-radius: 8rpx;
}

.type-btn.active {
  background-color: #000;
  color: #fff;
  border-color: #000;
}

.type-btn.clear {
  background-color: #f0f0f0;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.list-title {
  font-size: 36rpx;
  font-weight: 600;
}

.list-subtitle {
  font-size: 28rpx;
  color: #999;
}

.loading {
  display: flex;
  justify-content: center;
  padding: 40rpx;
}

.pokemon-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

@media (min-width: 768px) {
  .pokemon-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

.pokemon-card {
  border: 1px solid #eee;
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  cursor: pointer;
}

.pokemon-image {
  width: 160rpx;
  height: 160rpx;
}

.pokemon-name {
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
}

.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 30rpx;
  margin-top: 40rpx;
}

.pagination button {
  margin: 0;
}