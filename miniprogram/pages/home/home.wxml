<!-- pages/home/home.wxml -->
<view class="container">
  <!-- 头部 -->
  <view class="header">
    <text class="title">Welcome to Pokemon world</text>
    <text class="total">Total count: {{total}}</text>
  </view>

  <!-- 名字过滤输入框 -->
  <view class="filter-section">
    <div class="filter-row">
      <text>在此输入过滤👉</text>
      <input 
        type="text" 
        placeholder="输入名字过滤" 
        placeholder-class="placeholder-style"
        value="{{filterText}}" 
        bindinput="onFilterInput" 
      />
      <image wx:if="{{isFiltering}}" src="/images/loading.svg" mode="aspectFit" class="filter-loading" />
    </div>
  </view>

  <!-- 类型选择区域（可折叠） -->
  <view class="type-section">
    <view class="type-header" bindtap="toggleTypes">
      <text class="section-label">Types:</text>
      <text class="toggle-icon">{{typesExpanded ? '▼' : '▶'}}</text>
    </view>
    <view wx:if="{{typesExpanded}}" class="type-buttons">
      <button
        wx:for="{{types}}"
        wx:key="name"
        size="mini"
        class="type-btn {{selectedType === item.name ? 'active' : ''}}"
        data-type="{{item.name}}"
        bindtap="onSelectType"
      >
        {{item.name}}
      </button>
      <button
        wx:if="{{selectedType}}"
        size="mini"
        class="type-btn clear"
        bindtap="onClearType"
      >
        Clear
      </button>
    </view>
  </view>

  <!-- 列表区域 -->
  <view class="list-section">
    <view class="list-header">
      <text class="list-title">
        {{selectedType ? 'Selected type: ' + selectedType : 'All Pokémon'}}
        {{filterText ? ' (过滤: ' + filterText + ')' : ''}}
      </text>
      <text class="list-subtitle">Page {{page}} / {{totalPages}}</text>
    </view>

    <view wx:if="{{loading}}" class="loading">
      <image src="/images/loading.svg" mode="aspectFit" style="width: 60rpx; height: 60rpx;" />
    </view>

    <view wx:else class="pokemon-grid">
      <view
        wx:for="{{filteredList}}"
        wx:key="name"
        wx:for-index="index"
        class="pokemon-card"
        data-name="{{item.name}}"
        bindtap="goToDetail"
      >
        <image
          src="{{item.imageUrl}}"
          mode="aspectFit"
          class="pokemon-image"
          binderror="onImageError"
          data-default="{{CONFIG.DEFAULT_POKEMON_IMAGE}}"
          data-index="{{index}}"
        />
        <text class="pokemon-name">#{{item.url.split('/')[6]}} {{item.name}}</text>
      </view>
      <view wx:if="{{filteredList.length === 0 && !loading}}" class="no-result">
        没有匹配的宝可梦
      </view>
    </view>

    <view wx:if="{{!loading && totalPages > 0 && !filterText}}" class="pagination">
      <button
        size="mini"
        disabled="{{page <= 1}}"
        data-page="{{page - 1}}"
        bindtap="onPageChange"
      >Prev</button>
      <text>{{page}} / {{totalPages}}</text>
      <button
        size="mini"
        disabled="{{page >= totalPages}}"
        data-page="{{page + 1}}"
        bindtap="onPageChange"
      >Next</button>
    </view>
  </view>
</view>